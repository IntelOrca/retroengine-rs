+if(RETRO_HARNESS)
+    if(NOT BLAKE3_DIR)
+        message(FATAL_ERROR "RETRO_HARNESS requires -DBLAKE3_DIR=<dir containing blake3.c>")
+    endif()
+    target_sources(RetroEngine PRIVATE RSDKv5/refharness.cpp ${BLAKE3_DIR}/blake3.c ${BLAKE3_DIR}/blake3_dispatch.c
+                                      ${BLAKE3_DIR}/blake3_portable.c)
+    target_include_directories(RetroEngine PRIVATE ${BLAKE3_DIR})
+    target_compile_definitions(RetroEngine PRIVATE RETRO_HARNESS=1 BLAKE3_NO_SSE2 BLAKE3_NO_SSE41 BLAKE3_NO_AVX2 BLAKE3_NO_AVX512
+                                                   BLAKE3_NO_NEON)
+endif()
+
 target_include_directories(RetroEngine PRIVATE
     RSDKv5/
     dependencies/all/
