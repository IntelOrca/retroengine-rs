+                (unsigned)menu->rowCount, (unsigned)menu->visibleRowCount, (unsigned)menu->visibleRowOffset, menu->selection1,
+                menu->selection2, (unsigned)menu->selectionCount, (unsigned)menu->alignment, (int)menu->timer, menu->textDataPos);
+        int rows = menu->rowCount < LEGACY_TEXTENTRY_COUNT ? menu->rowCount : LEGACY_TEXTENTRY_COUNT;
+        for (int i = 0; i < rows; ++i)
+            fprintf(file, "%s%d", i ? "," : "", menu->entryStart[i]);
+        fputs("],\"entrySize\":[", file);
+        for (int i = 0; i < rows; ++i)
+            fprintf(file, "%s%d", i ? "," : "", menu->entrySize[i]);
+        fputs("],\"entryHighlight\":[", file);
+        for (int i = 0; i < rows; ++i)
+            fprintf(file, "%s%d", i ? "," : "", menu->entryHighlight[i] ? 1 : 0);
+        fputs("]}", file);
+    }
+    fputc(']', file);
+}
