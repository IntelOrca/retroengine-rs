+// Rebuilds the Rust `retro-input` button mask from a controller's held state, so the record
+// shows what the engine actually saw after ProcessInput's press->down conversion.
+static unsigned short controllerMask(int c)
+{
+    const ControllerState *state = &controller[c];
+    unsigned short mask          = 0;
+    if (state->keyUp.down)
+        mask |= BTN_UP;
+    if (state->keyDown.down)
+        mask |= BTN_DOWN;
+    if (state->keyLeft.down)
+        mask |= BTN_LEFT;
+    if (state->keyRight.down)
+        mask |= BTN_RIGHT;
+    if (state->keyA.down)
+        mask |= BTN_A;
+    if (state->keyB.down)
+        mask |= BTN_B;
+    if (state->keyC.down)
+        mask |= BTN_C;
+    if (state->keyX.down)
+        mask |= BTN_X;
+    if (state->keyY.down)
+        mask |= BTN_Y;
+    if (state->keyZ.down)
+        mask |= BTN_Z;
+    if (state->keyStart.down)
+        mask |= BTN_START;
+    if (state->keySelect.down)
+        mask |= BTN_SELECT;
+    return mask;
+}
