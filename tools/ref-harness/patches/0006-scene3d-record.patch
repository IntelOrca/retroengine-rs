+// The buffer digests below reinterpret the structs as i32 arrays, so the layouts must stay
+// tightly packed (integer fields only, no padding).
+static_assert(sizeof(Legacy::Vertex) == 5 * sizeof(int32), "Vertex layout changed");
+static_assert(sizeof(Legacy::Face) == 6 * sizeof(int32), "Face layout changed");
+static_assert(sizeof(Legacy::Matrix) == 16 * sizeof(int32), "Matrix layout changed");
+
+// BLAKE3 of `count` i32 values serialized little-endian, the canonical digest the Rust port can
+// reproduce (`faceBuffer.color` is a uint32 bit pattern and is hashed through the same cast).
+static void hashI32LE(const int32 *values, size_t count, char *out)
+{
+    static std::vector<unsigned char> scratch;
+    scratch.resize(count * 4);
+    for (size_t i = 0; i < count; ++i) {
+        uint32 value = (uint32)values[i];
+        scratch[i * 4 + 0] = (unsigned char)(value & 0xFF);
+        scratch[i * 4 + 1] = (unsigned char)((value >> 8) & 0xFF);
+        scratch[i * 4 + 2] = (unsigned char)((value >> 16) & 0xFF);
+        scratch[i * 4 + 3] = (unsigned char)((value >> 24) & 0xFF);
+    }
+
+    unsigned char digest[32];
+    blake3_hasher hasher;
+    blake3_hasher_init(&hasher);
+    blake3_hasher_update(&hasher, scratch.data(), scratch.size());
+    blake3_hasher_finalize(&hasher, digest, sizeof(digest));
+    static const char *hex = "0123456789abcdef";
+    for (int i = 0; i < 32; ++i) {
+        out[i * 2]     = hex[digest[i] >> 4];
+        out[i * 2 + 1] = hex[digest[i] & 0xF];
+    }
+    out[64] = 0;
+}
+
+static void writeMatrix(FILE *file, const Legacy::Matrix *matrix)
+{
+    fputc('[', file);
+    for (int i = 0; i < 16; ++i)
+        fprintf(file, "%s%d", i ? "," : "", matrix->values[i / 4][i % 4]);
+    fputc(']', file);
+}
