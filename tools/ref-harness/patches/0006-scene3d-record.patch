+// Dumps the legacy v4 3D state (M9): the six scalars, the three persisted 4x4 matrices and
+// BLAKE3 digests of the full vertex/face buffers, so the 3D port can be diffed field by field
+// even when the framebuffer agrees.
+static void writeScene3D(FILE *file)
+{
+    char vertexDigest[65];
+    char faceDigest[65];
+    hashI32LE((const int32 *)Legacy::v4::vertexBuffer, (size_t)LEGACY_v4_VERTEXBUFFER_SIZE * 5, vertexDigest);
+    hashI32LE((const int32 *)Legacy::v4::faceBuffer, (size_t)LEGACY_v4_FACEBUFFER_SIZE * 6, faceDigest);
+
+    fprintf(file,
+            ",\"scene3D\":{\"vertexCount\":%d,\"faceCount\":%d,\"projectionX\":%d,\"projectionY\":%d,\"fogColor\":%d,"
+            "\"fogStrength\":%d,\"matWorld\":",
+            Legacy::vertexCount, Legacy::faceCount, Legacy::projectionX, Legacy::projectionY, Legacy::v4::fogColor,
+            Legacy::v4::fogStrength);
+    writeMatrix(file, &Legacy::matWorld);
+    fputs(",\"matView\":", file);
+    writeMatrix(file, &Legacy::matView);
+    fputs(",\"matTemp\":", file);
+    writeMatrix(file, &Legacy::matTemp);
+    fprintf(file, ",\"vertexHash\":\"%s\",\"faceHash\":\"%s\"}", vertexDigest, faceDigest);
+}
